# ─── Plantilla de variables de entorno ───────────────────────────────────
# Copia este archivo a `.env` y rellena los valores. `.env` está en
# .gitignore — nunca debe commitearse.
#
# Generar SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Local: True. En producción: False (obligatorio).
DEBUG=True

# Sin default en settings.py — el arranque falla si esta variable no existe.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-50-caracteres

# Lista separada por comas. En prod usar el dominio real.
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Base de datos ───────────────────────────────────────────────────────
POSTGRES_DB=cajamenor
POSTGRES_USER=cajamenor_user
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── OCR (opcional, ya tiene defaults razonables) ────────────────────────
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_DATA=./tessdata
